@inject CarScraper.Web.Data.ISearchRepository Repository
@inject CarScraper.Web.Services.SearchQueue Queue

<h2>Search criteria</h2>
<p class="muted">Enter a postcode and at least one make and model. Optional limits can stay blank.</p>
<EditForm Model="_definition" OnValidSubmit="SaveAsync" FormName="new-search" autocomplete="off">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-grid">
        <label>Postcode<InputText @bind-Value="_definition.Postcode" /></label>
        <label>Radius (miles)<InputNumber @bind-Value="_definition.Radius" /></label>
        <label>Minimum price (£)<InputNumber @bind-Value="_definition.PriceFrom" /></label>
        <label>Maximum price (£)<InputNumber @bind-Value="_definition.PriceTo" /></label>
    </div>
    <label class="checkbox"><InputCheckbox @bind-Value="_isAnyAge" @bind-Value:after="UpdateYearFilter" /> Any age</label>
    @if (!_isAnyAge)
    {
        <div class="form-grid">
            <label>Earliest year<InputNumber @bind-Value="_definition.YearFrom" /></label>
            <label>Latest year<InputNumber @bind-Value="_definition.YearTo" /></label>
        </div>
    }
    <p class="muted small">Leave an optional limit blank to search without that filter.</p>
    <h3>Makes and models</h3>
    @foreach (var car in _definition.Cars)
    {
        <div class="car-row" @key="car">
            <BrandCombobox Brands="_brands" @bind-Value="car.Make" />
            <label>Model<InputText @bind-Value="car.Model" /></label>
            <button type="button" class="secondary remove" @onclick="() => _definition.Cars.Remove(car)" aria-label="Remove car">Remove</button>
        </div>
    }
    <button type="button" class="secondary" @onclick="() => _definition.Cars.Add(new())">+ Add a car</button>
    <details open>
        <summary>Search options</summary>
        <div class="form-grid">
            <label>Pages per make/model<InputNumber @bind-Value="_definition.MaxPages" /></label>
            <label>Delay between pages (seconds)<InputNumber @bind-Value="_definition.DelaySeconds" /></label>
        </div>
        <label class="checkbox"><InputCheckbox @bind-Value="_definition.IsHeadless" /> Run Chrome in the background</label>
        <p class="muted small">Leave unchecked to handle cookie consent in Chrome.</p>
    </details>
    <button type="submit" disabled="@(_isSaving || !RendererInfo.IsInteractive)">@(_isSaving ? "Starting search…" : "Start search")</button>
</EditForm>
@if (_error is not null) { <p class="error" role="alert">@_error</p> }

@code {
    [Parameter] public EventCallback<long> OnSaved { get; set; }
    private readonly SearchDefinition _definition = new();
    private List<string> _brands = [];
    private bool _isSaving;
    private long? _savedId;
    private string? _error;
    private bool _isAnyAge;
    private int? _previousYearFrom;
    private int? _previousYearTo;

    protected override void OnInitialized() => _brands = Repository.GetCarBrands();

    private void UpdateYearFilter()
    {
        if (_isAnyAge)
        {
            _previousYearFrom = _definition.YearFrom;
            _previousYearTo = _definition.YearTo;
            _definition.YearFrom = null;
            _definition.YearTo = null;
        }
        else
        {
            _definition.YearFrom = _previousYearFrom;
            _definition.YearTo = _previousYearTo;
        }
    }

    private async Task SaveAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        _error = null;
        try
        {
            _savedId ??= Repository.Create(_definition);
            Queue.Start(_savedId.Value);
            await OnSaved.InvokeAsync(_savedId.Value);
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            _error = $"Could not save the search: {exception.Message}";
        }
        finally { _isSaving = false; }
    }
}
