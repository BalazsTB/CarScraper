@inject CarScraper.Web.Data.ISearchRepository Repository
@inject ILogger<SearchHistory> Logger

<div class="section-heading history-heading">
    <p class="muted">@_searches.Count saved searches</p>
    <button class="secondary" @onclick="Refresh">Refresh</button>
</div>
@if (_error is not null) { <p class="error" role="alert">@_error</p> }
else if (_searches.Count == 0)
{
    <div class="panel empty"><h2>No searches yet</h2><p>Your searches will appear here once you start one.</p><a class="button-link" href="/search/new">Start a new search</a></div>
}
else
{
    <ul class="search-list" aria-label="Previous searches">
        @foreach (var search in _searches)
        {
            <li class="history-row" @key="search.Id">
                <a class="history-item" href="@($"/searches/{search.Id}")">
                    <div class="history-description">
                        <span class="small muted">Search #@search.Id · @Date(search.CreatedAt)</span>
                        <h2>@search.Description</h2>
                        <p>@search.Definition.Postcode · @(search.Definition.Radius is int radius ? $"Within {radius} miles" : "Any distance") · @Budget(search.Definition)</p>
                    </div>
                    <span class="badge @search.Status">@search.Status</span>
                    <span class="result-count"><strong>@search.ResultCount</strong> results</span>
                    <span class="history-arrow" aria-hidden="true">→</span>
                </a>
                <DeleteSearchButton Search="search" OnDeleted="Refresh" />
            </li>
        }
    </ul>
}

@code {
    private List<SearchRecord> _searches = [];
    private string? _error;
    protected override void OnInitialized() => Refresh();
    private void Refresh()
    {
        try { _searches = Repository.GetAll(); _error = null; }
        catch (Microsoft.Data.Sqlite.SqliteException exception)
        {
            Logger.LogError(exception, "Could not refresh search history");
            _error = "Could not read search history. Try Refresh in a moment.";
        }
    }
    private static string Date(string value) => DateTimeOffset.TryParse(value, out var date) ? date.ToLocalTime().ToString("dd MMM yyyy") : "Earlier search";
    private static string Money(int value) => value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
    private static string Budget(SearchDefinition definition) => (definition.PriceFrom, definition.PriceTo) switch
    {
        (int from, int to) => $"{Money(from)}–{Money(to)}",
        (int from, null) => $"From {Money(from)}",
        (null, int to) => $"Up to {Money(to)}",
        _ => "Any price"
    };
}
